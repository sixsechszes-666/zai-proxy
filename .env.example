# ---- upstream ----------------------------------------------------------
# api = the z.ai platform API over HTTPS, with ZAI_API_KEY below.
# web = chat.z.ai driven as your logged-in browser session, no API key at all.
#       Needs a signed-in chat.z.ai tab in Chrome on the CDP port. Tool calling
#       is forced through the shim, because that endpoint cannot take a tools
#       array. Read WEB_MODE.md first: the exit IP gets a 405 after about nine
#       requests in a burst, and a new egress node clears it.
ZAI_UPSTREAM=api

# GLM Coding Plan (subscription quota). Use this if you pay for the coding plan.
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# Pay-per-token endpoint instead:
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# China region:
# ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Your z.ai API key (or the coding-plan key). Not needed when ZAI_UPSTREAM=web.
ZAI_API_KEY=

# ---- models ------------------------------------------------------------
# glm-5.3-flash : 1M context, native multimodal, 131072 max output,
#                 reasoning ALWAYS on (cannot be disabled).
#                 $0.15/1M in, $0.50/1M out, $0.03/1M cached.
# glm-4.6       : smaller context, reasoning is optional. Cheaper per token
#                 on some plans and less to think about on every turn.
ZAI_MODEL=glm-5.3-flash
ZAI_SMALL_MODEL=glm-5.3-flash
ZAI_MAX_TOKENS=131072

# thinking: none | auto | on | off
#   none = never send the param          <- correct for glm-5.3-flash
#   auto = only when Claude Code asked
#   on   = always                        <- GLM-4.5 needs this
#   off  = always disabled               <- works on 4.5/4.6, ignored by 5.3
ZAI_THINKING=none

# GLM-5.3 only: low | high | max. Upstream defaults to "max", which is a lot
# of thinking on every Claude Code turn. Leave empty to take the default.
ZAI_REASONING_EFFORT=

# force a temperature (leave commented to pass Claude Code's value through).
# z.ai's own coding preset for 5.3 is temperature 0.95 / top_p 1.0.
# ZAI_TEMPERATURE=0.95

# show GLM's reasoning as Anthropic thinking blocks
ZAI_EXPOSE_REASONING=1

# ---- tool calling ------------------------------------------------------
# native = send a `tools` array upstream (needs a backend that accepts one:
#          the z.ai platform API does, the z.ai *web* endpoint does not)
# shim   = render the schemas into the prompt and parse the calls back out of
#          the reply. Works on any chat-only backend. Costs input tokens on
#          every turn and relies on the model following the envelope format.
# off    = drop tools, plain chat.
ZAI_TOOLS=native

# ---- web upstream (only with ZAI_UPSTREAM=web) -------------------------
# The model id the web app uses. Vadim's target model is GLM-5.3-Flash, which
# is `x-preview-l` on that backend, not `glm-5.3-flash`.
ZAI_WEB_MODEL=x-preview-l
# low | high | max. Web mode always sends reasoning_effort.
ZAI_WEB_EFFORT=max
# seconds of silence before a stalled stream is called dead
ZAI_WEB_IDLE=600
# CDP port of the browser that holds the signed-in chat.z.ai tab.
# ZAI_CDP_PORT=9222
# the frontend build the signature salt was extracted from. Bump it after a
# z.ai release and re-run `websig.py extract` (see WEB_MODE.md).
# ZAI_FE_VERSION=prod-fe-1.1.96

# ---- server ------------------------------------------------------------
PROXY_HOST=127.0.0.1
PROXY_PORT=8788
# if set, Claude Code must send this exact key. leave empty for localhost-any.
PROXY_TOKEN=

# ---- outbound proxy ----------------------------------------------------
# z.ai is usually only reachable through Clash from RU. The proxy honours your
# system env (HTTPS_PROXY / ALL_PROXY / NO_PROXY) by default, which is normally
# what you want -- your shell already has Clash configured.
#
# ZAI_DIRECT=1                     ignore env entirely, connect straight out
# ZAI_HTTP_PROXY=http://127.0.0.1:7897   force one explicit proxy
#
# SOCKS in ALL_PROXY needs socksio: pip install "httpx[socks]"
# ZAI_DIRECT=0

# dump every translated request/response to ./dumps (great for debugging tools)
ZAI_DUMP=0
